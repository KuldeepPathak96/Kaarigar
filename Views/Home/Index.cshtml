            </p>

            <div class="k-hero__cta">
                <a class="k-btn k-btn--primary k-btn--lg" href="/Account/Register?role=employer">
                    Hire Workers
                </a>
                <a class="k-btn k-btn--green k-btn--lg" href="/Account/Register?role=employee">
                    Find Work
                </a>
            </div>
        </div>

        <div class="k-hero__illustration">
            <div class="k-hero-card">
                <div class="k-hero-card__header">
                    <div class="k-hero-card__badge">LIVE REQUEST</div>
                </div>
                <div class="k-hero-card__title">2 Stewards Required</div>
                <div class="k-hero-card__meta"><i data-lucide="map-pin"></i> Vadodara • ₹80/hour </div>

                <div style="margin-top: 1.25rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <span style="background:#F3F4F6; padding:0.2rem 0.75rem; border-radius:9999px; font-size:0.8rem;"><i data-lucide="clock" style="width:14px;height:14px;vertical-align:-2px;"></i> Today • Evening Shift</span>
                    <span style="background:#F3F4F6; padding:0.2rem 0.75rem; border-radius:9999px; font-size:0.8rem;"><i data-lucide="zap" style="width:14px;height:14px;vertical-align:-2px;"></i> First Match in 12 Minutes</span>
                </div>
            </div>
        </div>
    </div>

    <div class="k-hero__industries">
        <div class="k-container">
            <p class="k-hero__industries-label">Industries We Serve</p>
            <div class="k-skills-track">
                @foreach (var industry in industries)
                {
                    <span class="k-skill-pill"><i data-lucide="@industry.Item1"></i> @industry.Item2</span>
                }
                @foreach (var industry in industries)
                {
                    <span class="k-skill-pill"><i data-lucide="@industry.Item1"></i> @industry.Item2</span>
                }
            </div>
        </div>
    </div>
</section>

<!-- ROLES SECTION -->
<section class="k-roles">
    <div class="k-container">
        <h2 class="k-section-title">How Kaarigar works?</h2>
        <p class="k-section-subtitle">Simple. Fast. Transparent.</p>

        <div class="k-roles__grid">
            <!-- Employer Card -->
            <div class="k-role-card k-role-card--employer">
                <div class="k-role-card__head">
                    <div class="k-role-card__icon"><i data-lucide="briefcase"></i></div>
                    <h3>Employers</h3>
                </div>
                <h4><i data-lucide="circle" style="width:12px;height:12px;fill:#F5B400;color:#F5B400;"></i> Need Staff?</h4>
                <ul class="k-role-card__steps">
                    <li>Post a Shift</li>
                    <li>Get Verified Workers</li>
                    <li>Start Work</li>
                    <li>Release Payment</li>
                </ul>
                <a href="/Account/Register?role=employer" class="k-btn k-btn--primary k-btn--full">Hire Workers</a>
            </div>

            <!-- Worker Card -->
            <div class="k-role-card k-role-card--employee">
                <div class="k-role-card__head">
                    <div class="k-role-card__icon"><i data-lucide="user-check"></i></div>
                    <h3>Workers</h3>
                </div>
                <h4><i data-lucide="circle" style="width:12px;height:12px;fill:#16A34A;color:#16A34A;"></i> Looking for Work?</h4>
                <ul class="k-role-card__steps">
                    <li>Create Profile</li>
                    <li>Receive Job Alerts</li>
                    <li>Accept Shift</li>
                    <li>Get Paid</li>
                </ul>
                <a href="/Account/Register?role=employee" class="k-btn k-btn--green k-btn--full">Find Work</a>
            </div>
        </div>
    </div>
</section>

