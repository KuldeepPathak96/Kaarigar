<script>
    document.querySelectorAll('.k-pain-item__head').forEach(function (head) {
        head.addEventListener('click', function () {
            var item = head.closest('.k-pain-item');
            var wasActive = item.classList.contains('active');

            document.querySelectorAll('.k-pain-item').forEach(function (i) {
                i.classList.remove('active');
                i.querySelector('.k-pain-item__head').setAttribute('aria-expanded', 'false');
            });

            if (!wasActive) {
                item.classList.add('active');
                head.setAttribute('aria-expanded', 'true');
            }
        });
    });
</script>

