<script>
    document.querySelectorAll('.k-faq-item__head').forEach(function (head) {
        head.addEventListener('click', function () {
            var item = head.closest('.k-faq-item');
            var wasActive = item.classList.contains('active');

            item.closest('.k-faq-accordion').querySelectorAll('.k-faq-item').forEach(function (i) {
                i.classList.remove('active');
                i.querySelector('.k-faq-item__head').setAttribute('aria-expanded', 'false');
            });

            if (!wasActive) {
                item.classList.add('active');
                head.setAttribute('aria-expanded', 'true');
            }
        });
    });
</script>
