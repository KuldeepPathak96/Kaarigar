@model Kaarigar.Models.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password — Kaarigar";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="k-auth-page">
    <div class="k-auth-card">

        <!-- Brand -->
        <a class="k-auth-brand" href="/">
            <img src="~/images/logo.png" alt="Kaarigar" class="k-auth-brand__logo" />
            <span class="k-auth-brand__name">KAARIGAR</span>
        </a>

        <h2 class="k-auth-title">Forgot Password</h2>
        <p class="k-auth-sub">Enter your registered email address. We'll send you a 6-digit OTP to reset your password.</p>

        @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
        {
            <div class="k-alert k-alert--error">@ViewBag.ErrorMessage</div>
        }

        <form asp-action="ForgotPassword" asp-controller="Account" method="post" class="k-form" id="forgotPasswordForm">
            @Html.AntiForgeryToken()

            <div class="k-form__group">
                <label asp-for="EmailId">Registered Email <span class="k-req">*</span></label>
                <input asp-for="EmailId"
                       class="k-input"
                       type="email"
                       placeholder="you@example.com"
                       autofocus />
                <span asp-validation-for="EmailId" class="k-field-error"></span>
            </div>

            <button type="submit" class="k-btn k-btn--primary k-btn--full k-btn--submit" id="sendOtpBtn">
                <span id="sendOtpBtnText">Send OTP</span>
                <span id="sendOtpSpinner" class="k-spinner" style="display:none;"></span>
            </button>
        </form>

        <p class="k-auth-switch mt-3">
            Remembered your password? <a href="/Account/Login">Back to Login</a>
        </p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('forgotPasswordForm').addEventListener('submit', function () {
            const btn = document.getElementById('sendOtpBtn');
            const text = document.getElementById('sendOtpBtnText');
            const spinner = document.getElementById('sendOtpSpinner');
            btn.disabled = true;
            text.style.display = 'none';
            spinner.style.display = 'inline-block';
        });
    </script>
}
