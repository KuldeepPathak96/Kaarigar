@model Kaarigar.Models.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password — Kaarigar";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="k-auth-page">
    <div class="k-auth-card">

        <!-- Brand -->
        <a class="k-auth-brand" href="/">
            <img src="~/images/logo.png" alt="Kaarigar" class="k-auth-brand__logo" />
            <span class="k-auth-brand__name">KAARIGAR</span>
        </a>

        <h2 class="k-auth-title">Set New Password</h2>
        <p class="k-auth-sub">Choose a new password for <strong>@Model.EmailId</strong>.</p>

        @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
        {
            <div class="k-alert k-alert--error">@ViewBag.ErrorMessage</div>
        }

        <form asp-action="ResetPassword" asp-controller="Account" method="post" class="k-form" id="resetPasswordForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="EmailId" />
            <input type="hidden" asp-for="OtpCd" />

            <div class="k-form__group">
                <label asp-for="NewPassword">New Password <span class="k-req">*</span></label>
                <input asp-for="NewPassword"
                       type="password"
                       class="k-input"
                       placeholder="At least 8 characters"
                       autofocus />
                <span asp-validation-for="NewPassword" class="k-field-error"></span>
            </div>

            <div class="k-form__group">
                <label asp-for="ConfirmPassword">Confirm New Password <span class="k-req">*</span></label>
                <input asp-for="ConfirmPassword"
                       type="password"
                       class="k-input"
                       placeholder="Re-enter new password" />
                <span asp-validation-for="ConfirmPassword" class="k-field-error"></span>
            </div>

            <button type="submit" class="k-btn k-btn--primary k-btn--full k-btn--submit" id="resetBtn">
                <span id="resetBtnText">Reset Password</span>
                <span id="resetSpinner" class="k-spinner" style="display:none;"></span>
            </button>
        </form>

        <p class="k-auth-switch mt-3">
            Remembered your password? <a href="/Account/Login">Back to Login</a>
        </p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('resetPasswordForm').addEventListener('submit', function () {
            const btn = document.getElementById('resetBtn');
            const text = document.getElementById('resetBtnText');
            const spinner = document.getElementById('resetSpinner');
            btn.disabled = true;
            text.style.display = 'none';
            spinner.style.display = 'inline-block';
        });
    </script>
}
