@model Kaarigar.Models.LoginModel
@{
    ViewData["Title"] = "Admin Login — Kaarigar";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="k-auth-page">
    <div class="k-auth-card">

        <a class="k-auth-brand" href="/admin/login">
            <img src="~/images/logo.png" alt="Kaarigar" class="k-auth-brand__logo" />
            <span class="k-auth-brand__name">KAARIGAR</span>
        </a>

        <h2 class="k-auth-title">Admin Sign In</h2>
        <p class="k-auth-sub">Restricted access. Authorized administrators only.</p>

        @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
        {
            <div class="k-alert k-alert--error">@ViewBag.ErrorMessage</div>
        }

        <form asp-action="AdminLogin" asp-controller="Account" method="post" class="k-form" id="adminLoginForm">
            @Html.AntiForgeryToken()

            <div class="k-form__group">
                <label asp-for="ContactNbr">Mobile Number <span class="k-req">*</span></label>
                <div class="k-input-prefix-group">
                    <span class="k-input-prefix">+91</span>
                    <input asp-for="ContactNbr"
                           class="k-input k-input--with-prefix"
                           maxlength="10"
                           inputmode="numeric"
                           autocomplete="off"
                           placeholder="9876543210" />
                </div>
                <span asp-validation-for="ContactNbr" class="k-field-error"></span>
            </div>

            <div class="k-form__group">
                <label asp-for="Password">Password <span class="k-req">*</span></label>
                <input asp-for="Password"
                       type="password"
                       class="k-input"
                       autocomplete="off"
                       placeholder="Enter your password" />
                <span asp-validation-for="Password" class="k-field-error"></span>
            </div>

            <button type="submit" class="k-btn k-btn--primary k-btn--full k-btn--submit" id="adminLoginBtn">
                <span id="adminLoginBtnText">Sign In</span>
                <span id="adminLoginSpinner" class="k-spinner" style="display:none;"></span>
            </button>
        </form>

        <!-- Intentionally no "Register" / "Forgot password" links here — this
             screen is for Admin only and is not part of the public sign-up funnel. -->
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('adminLoginForm').addEventListener('submit', function () {
            const btn = document.getElementById('adminLoginBtn');
            const text = document.getElementById('adminLoginBtnText');
            const spinner = document.getElementById('adminLoginSpinner');
            btn.disabled = true;
            text.style.display = 'none';
            spinner.style.display = 'inline-block';
        });
    </script>
}
