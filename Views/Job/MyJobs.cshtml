@model List<Kaarigar.Models.JobPostListItemViewModel>
@{
    ViewData["Title"] = "My Job Posts";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="k-dash-page">

    <div class="k-dash-header">
        <div>
            <h1 class="k-dash-title">My Job Posts</h1>
            <p class="k-dash-subtitle">Manage all the jobs you've posted.</p>
        </div>
        @if (ViewBag.IsApproved == true)
        {
            <a href="/job/post" class="k-btn k-btn--primary">+ Post a New Job</a>
        }
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
    {
        <div class="k-alert k-alert--success">@ViewBag.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="k-alert k-alert--error">@ViewBag.ErrorMessage</div>
    }

    @if (ViewBag.IsApproved != true)
    {
        <div class="k-alert k-alert--error" style="text-align:center">
            Your account is pending Admin approval. Once approved, you'll be able to post jobs and view your job posts here.
        </div>
    }
    else if (!Model.Any())
    {
        <div class="k-dash-section" style="text-align:center;color:#888">
            You haven't posted any jobs yet. <a href="/job/post">Post your first job</a>.
        </div>
    }
    else
    {
        <div class="k-job-card-grid">
            @foreach (var job in Model)
            {
                var badgeClass = job.StatusCd switch
                {
                    "ACTIVE" => "k-badge k-badge--green",
                    "PAUSED" => "k-badge k-badge--amber",
                    _ => "k-badge k-badge--red",
                };

                <div class="k-job-card">
                    <div class="k-job-card__header">
                        <h3>@job.JobTitle</h3>
                        <span class="@badgeClass">@job.StatusCd</span>
                    </div>
                    <p class="k-job-card__meta">
                        @(job.RequiredSkillNames.Any() ? string.Join(", ", job.RequiredSkillNames) : "No specific skills required")
                    </p>
                    <p class="k-job-card__meta">Posted: @job.DatePosted.ToString("dd MMM yyyy")</p>
                    <p class="k-job-card__meta"><strong>@job.ApplicationsCount</strong> application(s)</p>

                    <div class="k-job-card__actions">
                        <a href="/job/applicants/@job.JobPostId" class="k-btn k-btn--sm k-btn--secondary">View Applicants</a>
                        <a href="/job/edit/@job.JobPostId" class="k-btn k-btn--sm k-btn--secondary">Edit</a>

                        @if (job.StatusCd == "ACTIVE")
                        {
                            <form asp-action="ToggleStatus" asp-controller="Job" asp-route-id="@job.JobPostId" method="post" class="k-inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="newStatusCd" value="PAUSED" />
                                <button type="submit" class="k-btn k-btn--sm k-btn--secondary">Pause</button>
                            </form>
                        }
                        else if (job.StatusCd == "PAUSED")
                        {
                            <form asp-action="ToggleStatus" asp-controller="Job" asp-route-id="@job.JobPostId" method="post" class="k-inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="newStatusCd" value="ACTIVE" />
                                <button type="submit" class="k-btn k-btn--sm k-btn--secondary">Resume</button>
                            </form>
                        }

                        @if (job.StatusCd != "CLOSED")
                        {
                            <form asp-action="ToggleStatus" asp-controller="Job" asp-route-id="@job.JobPostId" method="post" class="k-inline-form"
                                  onsubmit="return confirm('Close this job post? This cannot be undone.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="newStatusCd" value="CLOSED" />
                                <button type="submit" class="k-btn k-btn--sm k-btn--danger">Close</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
