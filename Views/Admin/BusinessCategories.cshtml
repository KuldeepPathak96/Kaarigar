@model Kaarigar.Models.BusinessCategoryAdminViewModel
@{
    ViewData["Title"] = "Business Categories";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="k-dash-page">

    <div class="k-dash-header">
        <div>
            <h1 class="k-dash-title">Business Categories</h1>
            <p class="k-dash-subtitle">Manage the industry list employers pick from on their Profile page.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
    {
        <div class="k-alert k-alert--success">@ViewBag.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="k-alert k-alert--error">@ViewBag.ErrorMessage</div>
    }

    <!-- ── ADD NEW CATEGORY ─────────────────────────────────────────────── -->
    <div class="k-dash-section">
        <h2 class="k-dash-section__title">Add New Category</h2>
        <form asp-action="AddBusinessCategory" asp-controller="Admin" method="post" class="k-form k-form--inline">
            @Html.AntiForgeryToken()
            <div class="k-form__group k-form__group--grow">
                <input name="newCategoryName" class="k-input" placeholder="e.g. Logistics" required maxlength="150" />
            </div>
            <button type="submit" class="k-btn k-btn--primary">Add</button>
        </form>
    </div>

    <!-- ── EXISTING CATEGORIES ──────────────────────────────────────────── -->
    <div class="k-dash-section">
        <h2 class="k-dash-section__title">Existing Categories (@Model.Categories.Count)</h2>

        <table class="k-table">
            <thead>
                <tr>
                    <th>Category Name</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th style="text-align:right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories)
                {
                    <tr>
                        <td>@category.CategoryName</td>
                        <td>
                            @if (category.IsActiveFl)
                            {
                                <span class="k-badge k-badge--green">Active</span>
                            }
                            else
                            {
                                <span class="k-badge k-badge--red">Hidden</span>
                            }
                        </td>
                        <td>@category.CreatedTs.ToString("dd MMM yyyy")</td>
                        <td style="text-align:right">
                            @if (category.IsActiveFl)
                            {
                                <form asp-action="RemoveBusinessCategory" asp-controller="Admin" method="post" class="k-inline-form"
                                      onsubmit="return confirm('Remove &quot;@category.CategoryName&quot;? If it\'s in use by employers, it will be hidden instead of deleted.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="businessCategoryId" value="@category.BusinessCategoryId" />
                                    <button type="submit" class="k-btn k-btn--sm k-btn--danger">Remove</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="ReactivateBusinessCategory" asp-controller="Admin" method="post" class="k-inline-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="businessCategoryId" value="@category.BusinessCategoryId" />
                                    <button type="submit" class="k-btn k-btn--sm k-btn--secondary">Restore</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Categories.Any())
                {
                    <tr><td colspan="4" style="text-align:center;color:#888">No categories yet. Add the first one above.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
