@model Kaarigar.Models.SkillAdminViewModel
@{
    ViewData["Title"] = "Skills";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="k-dash-page">

    <div class="k-dash-header">
        <div>
            <h1 class="k-dash-title">Skills</h1>
            <p class="k-dash-subtitle">Manage the skills list used for Employee "My Skills", Job Post "Required Skills" and Job Title.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
    {
        <div class="k-alert k-alert--success">@ViewBag.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="k-alert k-alert--error">@ViewBag.ErrorMessage</div>
    }

    <!-- ── ADD NEW SKILL ────────────────────────────────────────────────── -->
    <div class="k-dash-section">
        <h2 class="k-dash-section__title">Add New Skill</h2>
        <form asp-action="AddSkill" asp-controller="Admin" method="post" class="k-form k-form--inline">
            @Html.AntiForgeryToken()
            <div class="k-form__group k-form__group--grow">
                <input name="newSkillName" class="k-input" placeholder="e.g. Electrician" required maxlength="100" />
            </div>
            <div class="k-form__group k-form__group--grow">
                <input name="newSkillCategory" class="k-input" placeholder="Category (optional), e.g. Skilled Trade" maxlength="100" />
            </div>
            <button type="submit" class="k-btn k-btn--primary">Add</button>
        </form>
    </div>

    <!-- ── EXISTING SKILLS ──────────────────────────────────────────────── -->
    <div class="k-dash-section">
        <h2 class="k-dash-section__title">Existing Skills (@Model.Skills.Count)</h2>

        <table class="k-table">
            <thead>
                <tr>
                    <th>Skill Name</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th style="text-align:right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var skill in Model.Skills)
                {
                    <tr>
                        <td>@skill.SkillName</td>
                        <td>@(skill.CategoryName ?? "—")</td>
                        <td>
                            @if (skill.IsActiveFl)
                            {
                                <span class="k-badge k-badge--green">Active</span>
                            }
                            else
                            {
                                <span class="k-badge k-badge--red">Hidden</span>
                            }
                        </td>
                        <td style="text-align:right">
                            @if (skill.IsActiveFl)
                            {
                                <form asp-action="RemoveSkill" asp-controller="Admin" method="post" class="k-inline-form" style="justify-content:flex-end"
                                      onsubmit="return confirm('Remove &quot;@skill.SkillName&quot;? If it\'s in use by employees or job posts, it will be hidden instead of deleted.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="skillId" value="@skill.SkillId" />
                                    <button type="submit" class="k-btn k-btn--sm k-btn--danger">Remove</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="ReactivateSkill" asp-controller="Admin" method="post" class="k-inline-form" style="justify-content:flex-end">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="skillId" value="@skill.SkillId" />
                                    <button type="submit" class="k-btn k-btn--sm k-btn--secondary">Restore</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Skills.Any())
                {
                    <tr><td colspan="4" style="text-align:center;color:#888">No skills yet. Add the first one above.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
