@model Kaarigar.Models.HourlyRateOptionAdminViewModel
@{
    ViewData["Title"] = "Hourly Rates";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="k-dash-page">

    <div class="k-dash-header">
        <div>
            <h1 class="k-dash-title">Hourly Rates</h1>
            <p class="k-dash-subtitle">Manage the preset rates employers can choose from when posting a job.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
    {
        <div class="k-alert k-alert--success">@ViewBag.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="k-alert k-alert--error">@ViewBag.ErrorMessage</div>
    }

    <!-- ── ADD NEW RATE ─────────────────────────────────────────────────── -->
    <div class="k-dash-section">
        <h2 class="k-dash-section__title">Add New Rate</h2>
        <form asp-action="AddHourlyRate" asp-controller="Admin" method="post" class="k-form k-form--inline">
            @Html.AntiForgeryToken()
            <div class="k-form__group k-form__group--grow">
                <input name="rateLabelTxt" class="k-input" placeholder="e.g. ₹80 / hour" required maxlength="100" />
            </div>
            <div class="k-form__group">
                <div class="k-input-prefix-group">
                    <span class="k-input-prefix">₹</span>
                    <input name="hourlyRateAmt" type="number" step="0.01" min="0.01" class="k-input k-input--with-prefix" placeholder="80" required />
                </div>
            </div>
            <button type="submit" class="k-btn k-btn--primary">Add</button>
        </form>
    </div>

    <!-- ── EXISTING RATES ───────────────────────────────────────────────── -->
    <div class="k-dash-section">
        <h2 class="k-dash-section__title">Existing Rates (@Model.RateOptions.Count)</h2>

        <table class="k-table">
            <thead>
                <tr>
                    <th>Label</th>
                    <th>Rate / Hour</th>
                    <th>Status</th>
                    <th style="text-align:right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rate in Model.RateOptions)
                {
                    <tr id="row-@rate.RateOptionId">
                        <!-- Display row -->
                        <td class="rate-display-@rate.RateOptionId">@rate.RateLabelTxt</td>
                        <td class="rate-display-@rate.RateOptionId">₹@rate.HourlyRateAmt.ToString("N2")</td>
                        <td>
                            @if (rate.IsActiveFl)
                            {
                                <span class="k-badge k-badge--green">Active</span>
                            }
                            else
                            {
                                <span class="k-badge k-badge--red">Hidden</span>
                            }
                        </td>
                        <td style="text-align:right">
                            <div class="k-inline-form" style="justify-content:flex-end;gap:6px">
                                <button type="button" class="k-btn k-btn--sm k-btn--secondary" onclick="toggleEdit(@rate.RateOptionId)">Edit</button>

                                @if (rate.IsActiveFl)
                                {
                                    <form asp-action="RemoveHourlyRate" asp-controller="Admin" method="post" class="k-inline-form"
                                          onsubmit="return confirm('Remove &quot;@rate.RateLabelTxt&quot;? If it\'s in use by job posts, it will be hidden instead of deleted.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="rateOptionId" value="@rate.RateOptionId" />
                                        <button type="submit" class="k-btn k-btn--sm k-btn--danger">Remove</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="ReactivateHourlyRate" asp-controller="Admin" method="post" class="k-inline-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="rateOptionId" value="@rate.RateOptionId" />
                                        <button type="submit" class="k-btn k-btn--sm k-btn--secondary">Restore</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>

                    <!-- Edit row (hidden by default) -->
                    <tr id="edit-row-@rate.RateOptionId" style="display:none">
                        <td colspan="4">
                            <form asp-action="EditHourlyRate" asp-controller="Admin" method="post" class="k-form k-form--inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="rateOptionId" value="@rate.RateOptionId" />
                                <div class="k-form__group k-form__group--grow">
                                    <input name="rateLabelTxt" class="k-input" value="@rate.RateLabelTxt" required maxlength="100" />
                                </div>
                                <div class="k-form__group">
                                    <div class="k-input-prefix-group">
                                        <span class="k-input-prefix">₹</span>
                                        <input name="hourlyRateAmt" type="number" step="0.01" min="0.01" class="k-input k-input--with-prefix" value="@rate.HourlyRateAmt" required />
                                    </div>
                                </div>
                                <button type="submit" class="k-btn k-btn--primary k-btn--sm">Save</button>
                                <button type="button" class="k-btn k-btn--secondary k-btn--sm" onclick="toggleEdit(@rate.RateOptionId)">Cancel</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.RateOptions.Any())
                {
                    <tr><td colspan="4" style="text-align:center;color:#888">No rates yet. Add the first one above.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function toggleEdit(id) {
        const displayCells = document.querySelectorAll('.rate-display-' + id);
        const editRow = document.getElementById('edit-row-' + id);
        const isHidden = editRow.style.display === 'none';

        editRow.style.display = isHidden ? 'table-row' : 'none';
        document.getElementById('row-' + id).style.display = isHidden ? 'none' : 'table-row';
    }
</script>
