@model Kaarigar.Models.EmployerDetailViewModel
@{
    ViewData["Title"] = "Employer Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var proofBadgeClass = Model.BusinessProofReviewStatusCd switch
    {
        "APPROVED" => "k-badge k-badge--green",
        "REJECTED" => "k-badge k-badge--red",
        _ => "k-badge k-badge--amber",
    };
}

<div class="k-dash-page">

    <div class="k-dash-header">
        <div>
            <h1 class="k-dash-title">@Model.Name</h1>
            <p class="k-dash-subtitle">@(Model.CompanyName ?? "Employer")</p>
        </div>
        <a href="/admin/employers" class="k-btn k-btn--sm k-btn--secondary">&larr; Back to Employers</a>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
    {
        <div class="k-alert k-alert--success">@ViewBag.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="k-alert k-alert--error">@ViewBag.ErrorMessage</div>
    }

    <div class="k-dash-section">
        <div class="k-dash-section__header">
            <h2 class="k-dash-section__title">Account</h2>
            @if (Model.IsActiveFl)
            {
                <span class="k-badge k-badge--green">Active</span>
            }
            else
            {
                <span class="k-badge k-badge--red">Blocked</span>
            }
        </div>

        <div class="k-form__row">
            <div class="k-form__group">
                <label>Mobile Number</label>
                <p>@Model.ContactNbr</p>
            </div>
            <div class="k-form__group">
                <label>Email</label>
                <p>@(Model.EmailId ?? "Not provided")</p>
            </div>
        </div>

        <div class="k-form__row">
            <div class="k-form__group">
                <label>Date Registered</label>
                <p>@Model.DateRegistered.ToString("dd MMM yyyy, hh:mm tt")</p>
            </div>
            <div class="k-form__group">
                <label>Last Login</label>
                <p>@(Model.LastLoginTs?.ToString("dd MMM yyyy, hh:mm tt") ?? "Never")</p>
            </div>
        </div>

        <div class="k-form__group">
            <label>Admin Approval</label>
            <p>
                @if (Model.IsApprovedFl)
                {
                    <span class="k-badge k-badge--green">Approved</span>
                }
                else
                {
                    <span class="k-badge k-badge--amber">Pending Approval</span>
                }
            </p>
        </div>
    </div>

    <div class="k-dash-section">
        <h2 class="k-dash-section__title">Business Profile</h2>

        <div class="k-form__row">
            <div class="k-form__group">
                <label>Company Name</label>
                <p>@(Model.CompanyName ?? "Not provided")</p>
            </div>
            <div class="k-form__group">
                <label>Contact Person</label>
                <p>@(Model.ContactPersonName ?? "Not provided")</p>
            </div>
        </div>

        <div class="k-form__row">
            <div class="k-form__group">
                <label>City</label>
                <p>@(Model.CityName ?? "Not provided")</p>
            </div>
            <div class="k-form__group">
                <label>Business Category</label>
                <p>@(Model.BusinessCategoryName ?? "Not provided")</p>
            </div>
        </div>

        <div class="k-form__group">
            <label>Area / Address</label>
            <p>@(Model.AreaAddressTxt ?? "Not provided")</p>
        </div>

        <div class="k-form__group">
            <label>Address</label>
            <p>@(Model.AddressTxt ?? "Not provided")</p>
        </div>

        <div class="k-dash-section__header">
            <h3 class="k-dash-section__title" style="font-size:16px">Business Proof</h3>
            <span class="@proofBadgeClass">@Model.BusinessProofReviewStatusCd</span>
        </div>
        <div class="k-form__row">
            <div class="k-form__group">
                <label>Proof Type</label>
                <p>@(Model.BusinessProofTypeCd ?? "Not provided")</p>
            </div>
            <div class="k-form__group">
                <label>Proof Number</label>
                <p>@(Model.BusinessProofNumberTxt ?? "Not provided")</p>
            </div>
        </div>
        <div class="k-form__group">
            <label>Uploaded Document</label>
            <p>
                @if (!string.IsNullOrEmpty(Model.BusinessProofFileUrl))
                {
                    <a href="@Model.BusinessProofFileUrl" target="_blank" rel="noopener" class="k-btn k-btn--sm k-btn--secondary">
                        View "@(Model.BusinessProofOriginalFileNameTxt ?? "document")"
                    </a>
                }
                else
                {
                    @:No document uploaded.
                }
            </p>

            @if (!string.IsNullOrEmpty(Model.BusinessProofFileUrl))
            {
                <div class="k-inline-form" style="gap:6px;margin-top:8px">
                    @if (Model.BusinessProofReviewStatusCd != "APPROVED")
                    {
                        <form asp-action="ApproveBusinessProof" asp-controller="Admin" asp-route-id="@Model.UserAccountId" method="post" class="k-inline-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="k-btn k-btn--sm k-btn--primary">Approve Document</button>
                        </form>
                    }
                    @if (Model.BusinessProofReviewStatusCd != "REJECTED")
                    {
                        <form asp-action="RejectBusinessProof" asp-controller="Admin" asp-route-id="@Model.UserAccountId" method="post" class="k-inline-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="k-btn k-btn--sm k-btn--danger">Reject Document</button>
                        </form>
                    }
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.LogoFileUrl))
        {
            <div class="k-form__group">
                <label>Company Logo</label>
                <p><a href="@Model.LogoFileUrl" target="_blank" rel="noopener" class="k-btn k-btn--sm k-btn--secondary">View Logo</a></p>
            </div>
        }
    </div>

    <div class="k-dash-section">
        <h2 class="k-dash-section__title">Job Activity</h2>
        <div class="k-kpi-grid k-kpi-grid--3">
            <div class="k-kpi-card">
                <div class="k-kpi-card__body">
                    <div class="k-kpi-card__value">@Model.JobsPostedCount</div>
                    <div class="k-kpi-card__label">Jobs Posted</div>
                </div>
            </div>
            <div class="k-kpi-card">
                <div class="k-kpi-card__body">
                    <div class="k-kpi-card__value k-kpi-card__value--green">@Model.ActiveJobsCount</div>
                    <div class="k-kpi-card__label">Active Jobs</div>
                </div>
            </div>
        </div>
    </div>

    <div class="k-dash-section">
        <div class="k-job-card__actions">
            <form asp-action="ToggleEmployerApproval" asp-controller="Admin" asp-route-id="@Model.UserAccountId" method="post" class="k-inline-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="k-btn @(Model.IsApprovedFl ? "k-btn--secondary" : "k-btn--primary")">
                    @(Model.IsApprovedFl ? "Revoke Approval" : "Approve Employer")
                </button>
            </form>

            <form asp-action="ToggleEmployerActive" asp-controller="Admin" asp-route-id="@Model.UserAccountId" method="post" class="k-inline-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="k-btn k-btn--secondary">
                    @(Model.IsActiveFl ? "Block Employer" : "Unblock Employer")
                </button>
            </form>

            <form asp-action="DeleteEmployer" asp-controller="Admin" asp-route-id="@Model.UserAccountId" method="post" class="k-inline-form"
                  onsubmit="return confirm('Delete this employer permanently? This cannot be undone.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="k-btn k-btn--danger">Delete Employer</button>
            </form>
        </div>
    </div>
</div>
