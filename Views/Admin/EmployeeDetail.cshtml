@model Kaarigar.Models.EmployeeDetailViewModel
@{
    ViewData["Title"] = "Employee Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="k-dash-page">

    <div class="k-dash-header">
        <div>
            <h1 class="k-dash-title">@Model.Name</h1>
            <p class="k-dash-subtitle">Job Seeker</p>
        </div>
        <a href="/admin/employees" class="k-btn k-btn--sm k-btn--secondary">&larr; Back to Employees</a>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
    {
        <div class="k-alert k-alert--success">@ViewBag.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="k-alert k-alert--error">@ViewBag.ErrorMessage</div>
    }

    <div class="k-dash-section">
        <div class="k-dash-section__header">
            <h2 class="k-dash-section__title">Account</h2>
            @if (Model.IsActiveFl)
            {
                <span class="k-badge k-badge--green">Active</span>
            }
            else
            {
                <span class="k-badge k-badge--red">Blocked</span>
            }
        </div>

        <div class="k-form__row">
            <div class="k-form__group">
                <label>Mobile Number</label>
                <p>@Model.ContactNbr</p>
            </div>
            <div class="k-form__group">
                <label>Email</label>
                <p>@(Model.EmailId ?? "Not provided")</p>
            </div>
        </div>

        <div class="k-form__row">
            <div class="k-form__group">
                <label>Date Registered</label>
                <p>@Model.DateRegistered.ToString("dd MMM yyyy, hh:mm tt")</p>
            </div>
            <div class="k-form__group">
                <label>Last Login</label>
                <p>@(Model.LastLoginTs?.ToString("dd MMM yyyy, hh:mm tt") ?? "Never")</p>
            </div>
        </div>

        <div class="k-form__group">
            <label>Admin Approval</label>
            <p>
                @if (Model.IsApprovedFl)
                {
                    <span class="k-badge k-badge--green">Approved</span>
                }
                else
                {
                    <span class="k-badge k-badge--amber">Pending Approval</span>
                }
            </p>
        </div>
    </div>

    <div class="k-dash-section">
        <h2 class="k-dash-section__title">Profile</h2>

        <div class="k-form__row">
            <div class="k-form__group">
                <label>City</label>
                <p>@(Model.CityName ?? "Not provided")</p>
            </div>
            <div class="k-form__group">
                <label>Preferred Job Radius</label>
                <p>@(Model.PreferredRadiusNbr.HasValue ? $"{Model.PreferredRadiusNbr.Value} km" : "Any")</p>
            </div>
        </div>

        <div class="k-form__group">
            <label>Area / Address</label>
            <p>@(Model.AreaAddressTxt ?? "Not provided")</p>
        </div>

        <div class="k-form__group">
            <label>Address</label>
            <p>@(Model.AddressTxt ?? "Not provided")</p>
        </div>

        <div class="k-form__group">
            <label>Skills</label>
            <p>@(Model.SkillNames.Any() ? string.Join(", ", Model.SkillNames) : "Not specified")</p>
        </div>
    </div>

    <div class="k-dash-section">
        <h2 class="k-dash-section__title">Job Activity</h2>
        <div class="k-kpi-grid k-kpi-grid--3">
            <div class="k-kpi-card">
                <div class="k-kpi-card__body">
                    <div class="k-kpi-card__value">@Model.ApplicationsCount</div>
                    <div class="k-kpi-card__label">Applications</div>
                </div>
            </div>
            <div class="k-kpi-card">
                <div class="k-kpi-card__body">
                    <div class="k-kpi-card__value k-kpi-card__value--green">@Model.JobsCompletedCount</div>
                    <div class="k-kpi-card__label">Jobs Completed</div>
                </div>
            </div>
        </div>
    </div>

    <div class="k-dash-section">
        <h2 class="k-dash-section__title">Uploaded Documents</h2>

        @if (!Model.Documents.Any())
        {
            <p style="color:#888">No documents uploaded yet.</p>
        }
        else
        {
            <div style="overflow-x:auto">
                <table class="k-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Details</th>
                            <th>File</th>
                            <th>Uploaded</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model.Documents)
                        {
                            <tr>
                                <td>@(doc.DocumentTypeCd == "ID_PROOF" ? "ID Proof" : "Resume")</td>
                                <td>
                                    @if (doc.DocumentTypeCd == "ID_PROOF")
                                    {
                                        @(string.IsNullOrEmpty(doc.IdLastFourDigitTxt)
                                            ? doc.DocumentSubtypeCd
                                            : $"{doc.DocumentSubtypeCd} · ending {doc.IdLastFourDigitTxt}")
                                    }
                                    else
                                    {
                                        @:—
                                    }
                                </td>
                                <td>
                                    <a href="@doc.FileUrl" target="_blank" rel="noopener" class="k-btn k-btn--sm k-btn--secondary">
                                        View "@doc.OriginalFileNameTxt"
                                    </a>
                                </td>
                                <td>@doc.UploadedTs.ToString("dd MMM yyyy")</td>
                                <td>
                                    @switch (doc.ReviewStatusCd)
                                    {
                                        case "APPROVED":
                                            <span class="k-badge k-badge--green">Approved</span>
                                            break;
                                        case "REJECTED":
                                            <span class="k-badge k-badge--red">Rejected</span>
                                            break;
                                        default:
                                            <span class="k-badge k-badge--amber">Pending Review</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="k-inline-form" style="gap:6px">
                                        @if (doc.ReviewStatusCd != "APPROVED")
                                        {
                                            <form asp-action="ApproveEmployeeDocument" asp-controller="Admin"
                                                  asp-route-employeeId="@Model.UserAccountId" asp-route-documentId="@doc.EmployeeDocumentId"
                                                  method="post" class="k-inline-form">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="k-btn k-btn--sm k-btn--primary">Approve</button>
                                            </form>
                                        }
                                        @if (doc.ReviewStatusCd != "REJECTED")
                                        {
                                            <form asp-action="RejectEmployeeDocument" asp-controller="Admin"
                                                  asp-route-employeeId="@Model.UserAccountId" asp-route-documentId="@doc.EmployeeDocumentId"
                                                  method="post" class="k-inline-form"
                                                  onsubmit="var r=prompt('Reason for rejecting this document (optional):'); if(r===null) return false; this.querySelector('[name=reason]').value=r;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="reason" value="" />
                                                <button type="submit" class="k-btn k-btn--sm k-btn--danger">Reject</button>
                                            </form>
                                        }
                                    </div>
                                    @if (doc.ReviewStatusCd == "REJECTED")
                                    {
                                        <div style="font-size:12px;color:#888;margin-top:4px">@doc.RejectionReasonTxt</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="k-dash-section">
        <div class="k-job-card__actions">
            <form asp-action="ToggleEmployeeApproval" asp-controller="Admin" asp-route-id="@Model.UserAccountId" method="post" class="k-inline-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="k-btn @(Model.IsApprovedFl ? "k-btn--secondary" : "k-btn--primary")">
                    @(Model.IsApprovedFl ? "Revoke Approval" : "Approve Employee")
                </button>
            </form>

            <form asp-action="ToggleEmployeeActive" asp-controller="Admin" asp-route-id="@Model.UserAccountId" method="post" class="k-inline-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="k-btn k-btn--secondary">
                    @(Model.IsActiveFl ? "Block Employee" : "Unblock Employee")
                </button>
            </form>

            <form asp-action="DeleteEmployee" asp-controller="Admin" asp-route-id="@Model.UserAccountId" method="post" class="k-inline-form"
                  onsubmit="return confirm('Delete this employee permanently? This cannot be undone.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="k-btn k-btn--danger">Delete Employee</button>
            </form>
        </div>
    </div>
</div>
