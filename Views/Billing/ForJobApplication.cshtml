@using Kaarigar.Models
@{
    ViewData["Title"] = "Invoices — Kaarigar";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var kaarigarInvoice = ViewBag.KaarigarInvoice as KaarigarInvoice;
    var websiteInvoice = ViewBag.WebsiteInvoice as WebsiteInvoice;
}

<div class="k-dash-header">
    <h1 class="k-dash-title">Invoices for This Job</h1>
    <p class="k-dash-subtitle">Generated automatically when the job was marked complete.</p>
</div>

<div class="k-dash-section">
    <h2 class="k-dash-section__title">Kaarigar Invoice — Platform Service Charge</h2>
    @if (kaarigarInvoice == null)
    {
        <p class="k-empty-state__text">Not generated yet.</p>
    }
    else
    {
        <div class="k-responsive-table-wrap"><table class="k-table k-table--responsive">
            <tbody>
                <tr><th>Invoice No.</th><td>@kaarigarInvoice.InvoiceNbr</td></tr>
                <tr><th>Date</th><td>@kaarigarInvoice.InvoiceDt.ToString("dd/MM/yyyy")</td></tr>
                <tr><th>Due Date</th><td>@kaarigarInvoice.DueDt.ToString("dd/MM/yyyy")</td></tr>
                <tr><th>Service Charge</th><td>₹@kaarigarInvoice.ServiceChargeAmt.ToString("N2")</td></tr>
                <tr><th>GST (@kaarigarInvoice.GstRatePct%)</th><td>₹@((kaarigarInvoice.CgstAmt + kaarigarInvoice.SgstAmt + kaarigarInvoice.IgstAmt).ToString("N2"))</td></tr>
                <tr><th>Total Payable</th><td><strong>₹@kaarigarInvoice.TotalAmt.ToString("N2")</strong></td></tr>
                <tr><th>Status</th><td><span class="k-badge">@kaarigarInvoice.StatusCd</span></td></tr>
            </tbody>
        </table></div>
        <a class="k-btn k-btn--primary k-btn--sm" style="margin-top:1rem;" href="/billing/kaarigar-invoice/@kaarigarInvoice.KaarigarInvoiceId/download" target="_blank">
            <i data-lucide="download"></i> Download PDF
        </a>
    }
</div>

<div class="k-dash-section">
    <h2 class="k-dash-section__title">Website Invoice — Worker Funding Amount</h2>
    @if (websiteInvoice == null)
    {
        <p class="k-empty-state__text">Not generated yet.</p>
    }
    else
    {
        <div class="k-responsive-table-wrap"><table class="k-table k-table--responsive">
            <tbody>
                <tr><th>Invoice No.</th><td>@websiteInvoice.InvoiceNbr</td></tr>
                <tr><th>Date</th><td>@websiteInvoice.InvoiceDt.ToString("dd/MM/yyyy")</td></tr>
                <tr><th>Hours × Rate</th><td>@websiteInvoice.HoursWorkedNbr.ToString("0.##") hrs × ₹@websiteInvoice.HourlyRateAmt.ToString("0.##")/hr</td></tr>
                <tr><th>Manpower Amount</th><td>₹@websiteInvoice.ManpowerAmt.ToString("N2")</td></tr>
                <tr><th>PF Employer Contribution</th><td>₹@websiteInvoice.PfEmployerAmt.ToString("N2")</td></tr>
                <tr><th>ESIC Employer Contribution</th><td>₹@websiteInvoice.EsicEmployerAmt.ToString("N2")</td></tr>
                <tr><th>GST (@websiteInvoice.GstRatePct%)</th><td>₹@((websiteInvoice.CgstAmt + websiteInvoice.SgstAmt + websiteInvoice.IgstAmt).ToString("N2"))</td></tr>
                <tr><th>Total Payable</th><td><strong>₹@websiteInvoice.TotalAmt.ToString("N2")</strong></td></tr>
                <tr><th>Status</th><td><span class="k-badge">@websiteInvoice.StatusCd</span></td></tr>
            </tbody>
        </table></div>
        <p class="k-form__hint" style="margin-top:0.75rem;">
            Payment collection (QR code) is not part of this feature yet — this invoice is generated and recorded only.
        </p>
        <a class="k-btn k-btn--primary k-btn--sm" href="/billing/website-invoice/@websiteInvoice.WebsiteInvoiceId/download" target="_blank">
            <i data-lucide="download"></i> Download PDF
        </a>
    }
</div>
