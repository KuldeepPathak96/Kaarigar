@model Kaarigar.Models.EmployerDashboardViewModel
@{
    ViewData["Title"] = "Employer Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="k-dash-page">

    <!-- ── PAGE HEADER ──────────────────────────────────────────────── -->
    <div class="k-dash-header">
        <div>
            <h1 class="k-dash-title">
                Welcome back,
                @(Model.CompanyName ?? Model.EmployerName) <i data-lucide="hand" style="width:22px;height:22px;vertical-align:-4px;"></i>
            </h1>
            <p class="k-dash-subtitle">Here's an overview of your hiring activity.</p>
        </div>
        @if (Model.IsApproved)
        {
            <a href="/job/post" class="k-btn k-btn--primary k-btn--lg">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Post Shift
            </a>
        }
        else
        {
            <span class="k-btn k-btn--primary k-btn--lg" style="opacity:.6;cursor:not-allowed" title="Your account is pending Admin approval">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Post Shift
            </span>
        }
    </div>

    @if (!Model.IsApproved)
    {
        <div class="k-alert k-alert--error" style="text-align:center">
            Your account is pending Admin approval. You'll be able to post jobs once approved.
        </div>
    }

    <!-- ── KPI CARDS ────────────────────────────────────────────────── -->
    <div class="k-kpi-grid k-kpi-grid--4">

        <a href="/job/my-jobs" class="k-kpi-card k-kpi-card--link">
            <div class="k-kpi-card__icon" style="background:#FFF7CC">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B45309" stroke-width="2">
                    <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                </svg>
            </div>
            <div class="k-kpi-card__body">
                <div class="k-kpi-card__value">@Model.TotalJobsPosted</div>
                <div class="k-kpi-card__label">Total Shift Posted</div>
            </div>
        </a>

        <div class="k-kpi-card k-kpi-card--expandable" data-kpi-toggle>
            <div class="k-kpi-card__icon" style="background:#D1FAE5">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#065F46" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
            </div>
            <div class="k-kpi-card__body">
                <div class="k-kpi-card__value k-kpi-card__value--green">@Model.ActiveJobs</div>
                <div class="k-kpi-card__label">Live Shift Status</div>
            </div>
            <div class="k-kpi-card__badge k-kpi-card__badge--green">Live</div>
            <div class="k-kpi-card__expand-hint">
                Details <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="6 9 12 15 18 9"/></svg>
            </div>

            <div class="k-kpi-detail-panel">
                @if (!Model.LiveShifts.Any())
                {
                    <div class="k-detail-panel-empty">No live or upcoming shifts right now.</div>
                }
                else
                {
                    @foreach (var shift in Model.LiveShifts)
                    {
                        <div class="k-shift-item">
                            <div class="k-shift-item__main">
                                <div class="k-shift-item__title">@shift.JobTitle</div>
                                <div class="k-shift-item__progress @(shift.IsFullyStaffed ? "k-shift-item__progress--full" : "")">
                                    @shift.ConfirmedWorkerNbr/@shift.RequiredWorkerNbr Confirmed
                                </div>
                                <div class="k-shift-item__timing">@shift.StartsInText</div>
                            </div>
                            @if (shift.IsFullyStaffed)
                            {
                                <span class="k-shift-item__cta k-shift-item__cta--muted">Fully Staffed</span>
                            }
                            else
                            {
                                <a href="/job/applicants/@shift.JobPostId" class="k-shift-item__cta">Find @shift.StillNeededNbr More Worker@(shift.StillNeededNbr == 1 ? "" : "s")</a>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <a href="/job/my-jobs" class="k-kpi-card k-kpi-card--link k-kpi-card--quick-action">
            <div class="k-kpi-card__icon" style="background:#EDE9FE">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4C1D95" stroke-width="2">
                    <polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/>
                    <polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>
                </svg>
            </div>
            <div class="k-kpi-card__body">
                <div class="k-kpi-card__value" style="font-size:1.25rem;">Repeat Shift</div>
                <div class="k-kpi-card__label">Quick Actions</div>
            </div>
            <div class="k-kpi-card__expand-hint">
                Go to Job List <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="transform:rotate(-90deg)"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
        </a>

        <div class="k-kpi-card k-kpi-card--expandable" data-kpi-toggle>
            <div class="k-kpi-card__icon" style="background:#FEF9C3">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#854D0E" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
            </div>
            <div class="k-kpi-card__body">
                <div class="k-kpi-card__value">@Model.JobsFilled</div>
                <div class="k-kpi-card__label">Positions Filled</div>
            </div>
            <div class="k-kpi-card__expand-hint">
                Details <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="6 9 12 15 18 9"/></svg>
            </div>

            <div class="k-kpi-detail-panel">
                @if (!Model.RecentlyFilled.Any())
                {
                    <div class="k-detail-panel-empty">No positions filled yet.</div>
                }
                else
                {
                    @foreach (var job in Model.RecentlyFilled)
                    {
                        <div class="k-detail-row">
                            <div class="k-detail-row__main">
                                <div class="k-detail-row__title">@job.JobTitle</div>
                                <div class="k-detail-row__sub">
                                    @job.ConfirmedWorkerNbr/@job.RequiredWorkerNbr filled
                                    @if (job.FilledTs.HasValue)
                                    {
                                        <text>&middot; @job.FilledTs.Value.ToLocalTime().ToString("dd MMM, hh:mm tt")</text>
                                    }
                                </div>
                            </div>
                            <a href="/job/applicants/@job.JobPostId" class="k-dash-section__link">View</a>
                        </div>
                    }
                }
            </div>
        </div>

    </div><!-- /.k-kpi-grid -->

</div><!-- /.k-dash-page -->

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('[data-kpi-toggle]').forEach(function (card) {
                card.addEventListener('click', function (e) {
                    // Let links inside the expanded detail panel (e.g. "Find 3
                    // More Workers", "View all applications") navigate normally
                    // instead of just toggling the card.
                    if (e.target.closest('a')) return;

                    var isOpen = card.classList.contains('is-open');

                    // Accordion behaviour: close any other open card first.
                    document.querySelectorAll('[data-kpi-toggle].is-open').forEach(function (c) {
                        if (c !== card) c.classList.remove('is-open');
                    });

                    card.classList.toggle('is-open', !isOpen);
                });
            });
        })();
    </script>
}
