@using Kaarigar.Services
@{
    var session  = UserSession.FromContext(Context);
    var role     = session.RoleCd ?? "";
    var fullName = session.FullName ?? "User";
    var initial  = fullName.Length > 0 ? fullName[..1].ToUpper() : "K";

    // Highlight the sidebar item whose Href the current URL path starts with.
    // (Comparing raw request paths is more reliable than matching controller/action
    // names one-by-one, since several actions — e.g. PostJob, EditJob, JobDetail —
    // all "belong" to the same nav item.)
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
    bool IsActive(string href) =>
        currentPath == href.ToLowerInvariant() ||
        currentPath.StartsWith(href.ToLowerInvariant() + "/");

    // Build nav items per role
    var navItems = role switch
    {
        "EMPLOYER" => new[]
        {
            (Icon:"grid",         Label:"Dashboard",    Href:"/dashboard/employer",       Active: IsActive("/dashboard/employer")),
            (Icon:"briefcase",    Label:"Post a Job",   Href:"/job/post",                 Active: IsActive("/job/post") || IsActive("/job/edit")),
            (Icon:"list",         Label:"My Job Posts", Href:"/job/my-jobs",              Active: IsActive("/job/my-jobs") || IsActive("/job/applicants") || IsActive("/job/applicant")),
            (Icon:"user",         Label:"My Profile",   Href:"/account/profile",          Active: IsActive("/account/profile")),
        },
        "EMPLOYEE" => new[]
        {
            (Icon:"grid",         Label:"Dashboard",    Href:"/dashboard/employee",       Active: IsActive("/dashboard/employee")),
            (Icon:"search",       Label:"Browse Jobs",  Href:"/jobs/browse",              Active: IsActive("/jobs/browse")),
            (Icon:"file-text",    Label:"My Applications", Href:"/applications",         Active: IsActive("/applications")),
            (Icon:"play-circle",  Label:"Learning Videos", Href:"/learning-videos",      Active: IsActive("/learning-videos")),
            (Icon:"user",         Label:"My Profile",   Href:"/account/profile",          Active: IsActive("/account/profile")),
        },
        "ADMIN" => new[]
        {
            (Icon:"grid",         Label:"Dashboard",    Href:"/dashboard/admin",          Active: IsActive("/dashboard/admin")),
            (Icon:"list",         Label:"Business Categories", Href:"/admin/business-categories", Active: IsActive("/admin/business-categories")),
            (Icon:"dollar-sign",  Label:"Hourly Rates",        Href:"/admin/hourly-rates",        Active: IsActive("/admin/hourly-rates")),
            (Icon:"briefcase",    Label:"Employers",    Href:"/admin/employers",          Active: IsActive("/admin/employers")),
            (Icon:"users",        Label:"Employees",    Href:"/admin/employees",          Active: IsActive("/admin/employees")),
            (Icon:"list",         Label:"Job Posts",    Href:"/admin/jobs",               Active: IsActive("/admin/jobs")),
            (Icon:"play-circle",  Label:"Learning Videos", Href:"/admin/learning-videos", Active: IsActive("/admin/learning-videos")),
            (Icon:"bell",         Label:"Notif Logs",   Href:"/admin/notifications",      Active: IsActive("/admin/notifications")),
        },
        _ => Array.Empty<(string Icon, string Label, string Href, bool Active)>()
    };

    var roleLabel = role switch { "EMPLOYER" => "Employer", "EMPLOYEE" => "Job Seeker", "ADMIN" => "Admin", _ => "" };
    var roleColor = role switch { "EMPLOYER" => "#FFCC00", "EMPLOYEE" => "#22C55E", "ADMIN" => "#6366F1", _ => "#6B7280" };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Kaarigar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/kaarigar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="k-body k-dash-body">

    <!-- ── MOBILE/TABLET TOP BAR ────────────────────────────────────── -->
    <header class="k-dash-topbar">
        <a href="/" class="k-dash-topbar__brand">
            <span class="k-dash-topbar__logo">K</span>
            <strong>Kaarigar</strong>
        </a>
        <div class="k-dash-topbar__right">
            @if (role == "EMPLOYEE")
            {
                <a href="/notifications" class="k-dash-notif-btn" aria-label="Notifications">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                </a>
            }
            <div class="k-dash-avatar k-dash-avatar--sm" style="background:@roleColor">@initial</div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="k-dash-topbar__logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="k-dash-notif-btn" aria-label="Sign out" title="Sign out">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                </button>
            </form>
        </div>
    </header>

    <div class="k-dash-shell">

        <!-- ── SIDEBAR ──────────────────────────────────────────────── -->
        <aside class="k-dash-sidebar" id="sidebar">
            <!-- Brand -->
            <a href="/" class="k-dash-sidebar__brand">
                <div class="k-dash-sidebar__logo">K</div>
                <div>
                    <div class="k-dash-sidebar__brand-name">Kaarigar</div>
                    <div class="k-dash-sidebar__role-badge" style="background:@(roleColor + "22");color:@roleColor">@roleLabel</div>
                </div>
            </a>

            <!-- Nav -->
            <nav class="k-dash-nav" aria-label="Dashboard navigation">
                @foreach (var item in navItems)
                {
                    <a href="@item.Href" class="k-dash-nav__item @(item.Active ? "k-dash-nav__item--active" : "")">
                        <span class="k-dash-nav__icon">@Html.Raw(GetIcon(item.Icon))</span>
                        <span class="k-dash-nav__label">@item.Label</span>
                    </a>
                }
            </nav>

            <!-- User block + logout -->
            <div class="k-dash-sidebar__footer">
                <div class="k-dash-user-block">
                    <div class="k-dash-avatar" style="background:@roleColor">@initial</div>
                    <div class="k-dash-user-block__info">
                        <div class="k-dash-user-block__name">@fullName</div>
                        <div class="k-dash-user-block__role">@roleLabel</div>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="k-dash-logout-btn" title="Sign out">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                        Sign out
                    </button>
                </form>
            </div>
        </aside>

        <!-- ── MAIN CONTENT ──────────────────────────────────────────── -->
        <main class="k-dash-main">
            @if (TempData["SessionKicked"] is string kicked)
            {
                <div class="k-dash-banner k-dash-banner--warn">⚠ @kicked</div>
            }
            @RenderBody()
        </main>

    </div><!-- /.k-dash-shell -->

    <!-- ── BOTTOM NAV (mobile/tablet — app-style icon tab bar) ──────────── -->
    <nav class="k-dash-bottomnav" aria-label="Dashboard navigation">
        @foreach (var item in navItems)
        {
            <a href="@item.Href" class="k-dash-bottomnav__item @(item.Active ? "k-dash-bottomnav__item--active" : "")" title="@item.Label" aria-label="@item.Label">
                <span class="k-dash-bottomnav__icon">@Html.Raw(GetIcon(item.Icon))</span>
            </a>
        }
    </nav>

    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    static string GetIcon(string name) => name switch
    {
        "grid"      => """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>""",
        "briefcase" => """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>""",
        "list"      => """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>""",
        "users"     => """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>""",
        "user"      => """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>""",
        "search"    => """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>""",
        "file-text" => """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>""",
        "shield"    => """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>""",
        "bell"      => """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>""",
        "play-circle" => """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>""",
        "dollar-sign" => """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>""",
        _           => """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>""",
    };
}
