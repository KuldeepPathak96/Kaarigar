@using Kaarigar.Services
@{
    ViewData["Title"] = "Billing — Kaarigar";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var summary = ViewBag.Summary as BillingDashboardSummary;
    var invoices = ViewBag.Invoices as List<BillingDashboardRow> ?? new List<BillingDashboardRow>();
}

<div class="k-dash-page">

    <div class="k-dash-header">
        <div>
            <h1 class="k-dash-title">Billing</h1>
            <p class="k-dash-subtitle">Kaarigar Invoices and Website Invoices generated on job completion.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="k-alert k-alert--success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="k-alert k-alert--error">@TempData["ErrorMessage"]</div>
    }

    <!-- ── KPI CARDS ────────────────────────────────────────────────── -->
    <div class="k-kpi-grid k-kpi-grid--4">
        <div class="k-kpi-card">
            <div class="k-kpi-card__icon" style="background:#FFF7CC">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B45309" stroke-width="2">
                    <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                </svg>
            </div>
            <div class="k-kpi-card__body">
                <div class="k-kpi-card__value">₹@(summary?.TotalKaarigarAmt.ToString("N0") ?? "0")</div>
                <div class="k-kpi-card__label">Kaarigar Invoices (@summary?.TotalKaarigarInvoices)</div>
            </div>
        </div>

        <div class="k-kpi-card">
            <div class="k-kpi-card__icon" style="background:#DBEAFE">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1E40AF" stroke-width="2">
                    <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                </svg>
            </div>
            <div class="k-kpi-card__body">
                <div class="k-kpi-card__value">₹@(summary?.TotalWebsiteAmt.ToString("N0") ?? "0")</div>
                <div class="k-kpi-card__label">Website Invoices (@summary?.TotalWebsiteInvoices)</div>
            </div>
        </div>

        <div class="k-kpi-card">
            <div class="k-kpi-card__icon" style="background:#FEE2E2">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#991B1B" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
            </div>
            <div class="k-kpi-card__body">
                <div class="k-kpi-card__value">₹@(summary?.PendingPaymentAmt.ToString("N0") ?? "0")</div>
                <div class="k-kpi-card__label">Pending Payment (@summary?.PendingPaymentCount)</div>
            </div>
        </div>

        <div class="k-kpi-card">
            <div class="k-kpi-card__icon" style="background:#D1FAE5">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#065F46" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
            </div>
            <div class="k-kpi-card__body">
                <div class="k-kpi-card__value k-kpi-card__value--green">@summary?.PaidCount</div>
                <div class="k-kpi-card__label">Paid Invoices</div>
            </div>
        </div>
    </div>

    <!-- ── FILTERS ──────────────────────────────────────────────────── -->
    <div class="k-dash-section">
        <form method="get" asp-action="Index" asp-controller="AdminBilling" class="k-form k-form--inline" style="flex-wrap:wrap">
            <select name="invoiceType" class="k-input k-select" style="max-width:180px">
                <option value="">All Invoice Types</option>
                <option value="KAARIGAR" selected="@(ViewBag.InvoiceTypeFilter == "KAARIGAR")">Kaarigar Invoice</option>
                <option value="WEBSITE" selected="@(ViewBag.InvoiceTypeFilter == "WEBSITE")">Website Invoice</option>
            </select>

            <select name="status" class="k-input k-select" style="max-width:180px">
                <option value="">All Statuses</option>
                <option value="DUE" selected="@(ViewBag.StatusFilter == "DUE")">Due</option>
                <option value="PENDING_PAYMENT" selected="@(ViewBag.StatusFilter == "PENDING_PAYMENT")">Pending Payment</option>
                <option value="PAID" selected="@(ViewBag.StatusFilter == "PAID")">Paid</option>
                <option value="OVERDUE" selected="@(ViewBag.StatusFilter == "OVERDUE")">Overdue</option>
            </select>

            <input type="date" name="fromDt" class="k-input" style="max-width:170px" value="@(ViewBag.FromDt as DateTime? )?.ToString("yyyy-MM-dd")" />
            <input type="date" name="toDt" class="k-input" style="max-width:170px" value="@(ViewBag.ToDt as DateTime?)?.ToString("yyyy-MM-dd")" />

            <button type="submit" class="k-btn k-btn--primary k-btn--sm">Filter</button>
            <a href="/admin/billing" class="k-btn k-btn--secondary k-btn--sm">Clear</a>
        </form>
    </div>

    <!-- ── INVOICE TABLE ────────────────────────────────────────────── -->
    <div class="k-dash-section">
        @if (!invoices.Any())
        {
            <div class="k-empty-state">
                <div class="k-empty-state__icon"><i data-lucide="receipt"></i></div>
                <p class="k-empty-state__text">No invoices match these filters.</p>
            </div>
        }
        else
        {
            <div class="k-responsive-table-wrap">
                <table class="k-table k-table--responsive">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Invoice No.</th>
                            <th>Date</th>
                            <th>Employer</th>
                            <th>Worker</th>
                            <th>Job</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>WhatsApp</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in invoices)
                        {
                            <tr>
                                <td>
                                    <span class="k-badge @(inv.InvoiceType == "KAARIGAR" ? "k-badge--amber" : "k-badge--blue")">
                                        @(inv.InvoiceType == "KAARIGAR" ? "Kaarigar" : "Website")
                                    </span>
                                </td>
                                <td>@inv.InvoiceNbr</td>
                                <td>@inv.InvoiceDt.ToString("dd/MM/yyyy")</td>
                                <td>@inv.EmployerName</td>
                                <td>@inv.WorkerName</td>
                                <td>@inv.JobTitle</td>
                                <td>₹@inv.TotalAmt.ToString("N2")</td>
                                <td>
                                    <span class="k-badge @(inv.StatusCd == "PAID" ? "k-badge--green" : inv.StatusCd == "OVERDUE" ? "k-badge--red" : "k-badge--amber")">
                                        @inv.StatusCd
                                    </span>
                                </td>
                                <td>
                                    @if (inv.WhatsAppSent)
                                    {
                                        <i data-lucide="check-circle" style="width:16px;height:16px;color:var(--k-green)"></i>
                                    }
                                    else
                                    {
                                        <i data-lucide="x-circle" style="width:16px;height:16px;color:var(--k-muted)"></i>
                                    }
                                </td>
                                <td style="white-space:nowrap;">
                                    @if (!string.IsNullOrEmpty(inv.PdfFilePathTxt))
                                    {
                                        <a href="/billing/@(inv.InvoiceType == "KAARIGAR" ? "kaarigar-invoice" : "website-invoice")/@inv.InvoiceId/download"
                                           target="_blank" class="k-btn k-btn--secondary k-btn--sm" title="Download PDF">
                                            <i data-lucide="download"></i>
                                        </a>
                                    }

                                    <form method="post" asp-action="ResendWhatsApp" asp-controller="AdminBilling" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="invoiceType" value="@inv.InvoiceType" />
                                        <input type="hidden" name="invoiceId" value="@inv.InvoiceId" />
                                        <button type="submit" class="k-btn k-btn--secondary k-btn--sm" title="Resend via WhatsApp">
                                            <i data-lucide="send"></i>
                                        </button>
                                    </form>

                                    @if (inv.StatusCd != "PAID")
                                    {
                                        <form method="post" asp-action="MarkPaid" asp-controller="AdminBilling" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="invoiceType" value="@inv.InvoiceType" />
                                            <input type="hidden" name="invoiceId" value="@inv.InvoiceId" />
                                            <button type="submit" class="k-btn k-btn--primary k-btn--sm" title="Mark as Paid">
                                                <i data-lucide="check"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
